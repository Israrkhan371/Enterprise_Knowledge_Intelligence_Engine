# Postgres
DATABASE_URL=postgresql://ekie:ekie_password@postgres:5432/ekie

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ekie_password

# Chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=ekie_documents

# LLM provider (set your own key)
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# App
ENV=development
LOG_LEVEL=INFO
