# Copy to .env ON THE CLOUD SERVER and fill in real values.
# This file is NEVER committed — same rule as .env.example.
# Everything below is identical to .env.example except EKIE_DOMAIN
# (new, read by docker/Caddyfile) and the two passwords, which you should
# change from the repo defaults before exposing this publicly.

# Your hostname for HTTPS — see docs/FREE_DEPLOYMENT_GUIDE.md Phase 3
# step 19 for how to get one free (DuckDNS) if you don't have a domain.
EKIE_DOMAIN=your-name.duckdns.org

# Postgres — CHANGE THIS PASSWORD before deploying publicly (the repo
# default "ekie_password" is fine for a laptop-only, non-exposed local dev
# setup, but Postgres itself is never exposed publicly in this deployment
# anyway — see docker-compose.prod.yml). POSTGRES_PASSWORD is read by
# docker-compose.yml itself (Compose auto-loads repo-root .env for its own
# ${VAR} substitution, separately from the env_file: the api container
# gets) to set the actual container password — it MUST match the password
# in DATABASE_URL below, or the api container won't be able to log in.
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD
DATABASE_URL=postgresql://ekie:CHANGE_THIS_PASSWORD@postgres:5432/ekie

# Neo4j — same pattern: NEO4J_PASSWORD sets the real container password via
# docker-compose.yml, NEO4J_URI/credentials below are what the api
# container connects with. Change both, keep them matching.
NEO4J_PASSWORD=CHANGE_THIS_PASSWORD
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# Chroma
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=ekie_documents

# LLM provider — Google Gemini (free tier, no billing required)
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# App
ENV=production
LOG_LEVEL=INFO
